    {
      "id": 9,
      "type": "bargauge",
      "title": "10 penyerang paling aktif (24 jam)",
      "description": "Alamat IP yang paling sering mencoba masuk. Semua sudah diblokir otomatis.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "YOUR_VICTORIALOGS_UID"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "stats",
          "instant": true,
          "expr": "job:cf-security action:block | stats by (ip, country) count() as serangan | sort by (serangan) desc | limit 10"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "serangan\\{country=\\\"([A-Z]+)\\\",ip=\\\"([^\\\"]+)\\\"\\}",
            "replacement": "$2 - $1"
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      }
    },
