  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status Pemantauan",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "YOUR_VICTORIALOGS_UID"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "stats",
          "instant": true,
          "expr": "job:cf-security _time:15m | stats count() as v"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0,
                "result": {
                  "text": "TIDAK ADA DATA",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": null,
                "result": {
                  "text": "PEMANTAUAN AKTIF",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "Hijau = data serangan masih masuk. Merah = pemantauan berhenti, hubungi petugas TI."
    },
